{
  "name": "e-shop-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "config": "node set-env.js",
    "start": "npm run config && ng serve --port %PORT%",
    "start:aspire": "npm run config && ng serve --disable-host-check --port $PORT",
    "build": "npm run config && ng build",
    "watch": "npm run config && ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:e-shop-web": "node dist/e-shop-web/server/server.mjs",
    "generate:proto": "protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src/generated --proto_path=./proto ./proto/*.proto"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.0.0",
    "@angular/common": "^17.0.0",
    "@angular/compiler": "^17.0.0",
    "@angular/core": "^17.0.0",
    "@angular/forms": "^17.0.0",
    "@angular/platform-browser": "^17.0.0",
    "@angular/platform-browser-dynamic": "^17.0.0",
    "@angular/platform-server": "^19.2.3",
    "@angular/router": "^17.0.0",
    "@angular/ssr": "^19.2.4",
    "bootstrap": "^5.3.3",
    "express": "^4.21.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.2",
    "@grpc/grpc-js": "^1.9.13",
    "@grpc/proto-loader": "^0.7.10",
    "google-protobuf": "^3.21.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.0.0",
    "@angular/cli": "^17.0.0",
    "@angular/compiler-cli": "^17.0.0",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.10.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.2.2",
    "ts-proto": "^1.165.0",
    "protoc": "^3.21.12"
  }
}
